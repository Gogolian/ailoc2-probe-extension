#!/bin/sh
# AILoc2 managed hook: pre-commit


CLI_PATH="./.githooks/ailoc2-hook-runtime.cjs"
if [ ! -f "$CLI_PATH" ]; then
    AILOC2_COMMON_DIR=$(git rev-parse --git-common-dir 2>/dev/null) || AILOC2_COMMON_DIR=""
    if [ -n "$AILOC2_COMMON_DIR" ]; then
        AILOC2_MAIN_WORKTREE=$(CDPATH= cd -- "$AILOC2_COMMON_DIR/.." 2>/dev/null && pwd) || AILOC2_MAIN_WORKTREE=""
        if [ -n "$AILOC2_MAIN_WORKTREE" ] && [ -f "$AILOC2_MAIN_WORKTREE/.githooks/ailoc2-hook-runtime.cjs" ]; then
            CLI_PATH="$AILOC2_MAIN_WORKTREE/.githooks/ailoc2-hook-runtime.cjs"
        fi
    fi
fi

run_delegate_hooks() {
    return 0
}

if command -v node >/dev/null 2>&1 && [ -f "$CLI_PATH" ]; then
    node "$CLI_PATH" prepare-commit >/dev/null 2>&1 || printf '%s
' 'AILoc2 pre-commit warning: baseline preparation or summary refresh failed; continuing without blocking the commit.' >&2
else
    printf '%s
' 'AILoc2 pre-commit warning: Node CLI is unavailable; skipping summary refresh.' >&2
fi

run_delegate_hooks "$@"
exit $?
