<idea-plugin>
  <id>com.ailoc2.probe</id>
  <name>AILoc2 Probe</name>
  <vendor email="issues@gogolian.invalid" url="https://github.com/Gogolian/ailoc2-probe-extension">Gogolian</vendor>
  <description><![CDATA[
    Local-first AI attribution for IntelliJ IDEA commits. AILoc2 observes editor edits, estimates staged AI-assisted change percentage without prompt or instruction tagging, and annotates commit messages.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>Git4Idea</depends>

  <extensions defaultExtensionNs="com.intellij">
    <postStartupActivity implementation="com.ailoc2.intellij.Ailoc2StartupActivity" />
    <checkinHandlerFactory implementation="com.ailoc2.intellij.Ailoc2CheckinHandlerFactory" />
  </extensions>

  <actions>
    <action id="Ailoc2.InstallHooks"
            class="com.ailoc2.intellij.Ailoc2InstallHooksAction"
            text="AILoc2 Probe: Install Repo Hooks"
            description="Install AILoc2 Git hooks for the current repository">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>
    <action id="Ailoc2.UninstallHooks"
            class="com.ailoc2.intellij.Ailoc2UninstallHooksAction"
            text="AILoc2 Probe: Uninstall Repo Hooks"
            description="Uninstall AILoc2 Git hooks from the current repository">
      <add-to-group group-id="ToolsMenu" anchor="last" />
    </action>
  </actions>
</idea-plugin>
